OPENAI_API_KEY=sk-...
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=datasheets

# Arize Phoenix (observability)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=datasheet-rag
# PHOENIX_API_KEY=   # only needed if Phoenix runs with auth enabled

# --- Datasheet MCP server (docs/05-mcp-server.md, docs/06-entra-setup.md) ---
MCP_AUTH_MODE=entra                       # entra | none (none = local development only)
MCP_BASE_URL=http://localhost:8000        # URL clients use to reach the server (also the OAuth callback base)
MCP_JWT_SIGNING_KEY=                      # long random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENTRA_TENANT_ID=                          # Directory (tenant) ID
ENTRA_CLIENT_ID=                          # Application (client) ID of the "Datasheet MCP" app registration
ENTRA_CLIENT_SECRET=                      # client secret VALUE
ENTRA_REQUIRED_SCOPE=Datasheets.Read
ENTRA_REQUIRED_ROLE=Datasheet.Reader
